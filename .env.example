# Строка подключения к managed PostgreSQL от хостера
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Секрет для подписи JWT-сессий. Генерировать: openssl rand -hex 32
SESSION_SECRET=

# Секрет для ALTCHA challenge/verification. Генерировать: openssl rand -hex 32
ALTCHA_HMAC_KEY=

# Базовый URL приложения для абсолютных ссылок в исходящих событиях
APP_URL=http://localhost:3000

# Исходящие события во внешний transport-сервис
OUTBOUND_EVENTS_WEBHOOK_URL=
OUTBOUND_EVENTS_SECRET=
OUTBOUND_EVENTS_TIMEOUT_MS=3000

# Входящий импорт из внешнего бота. Генерировать: openssl rand -hex 32
IMPORT_API_SECRET=
IMPORT_API_SECRET_HEADER=x-import-secret

# S3-совместимое хранилище
# Локально (MinIO): запустить через docker compose --profile local up -d minio
#   затем создать бакет в консоли http://localhost:9001
# Продакшн: Yandex Object Storage, AWS S3, Selectel и т.д.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=proletarka
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Публичный базовый адрес бакета или CDN без завершающего /.
# Новые изображения хранятся в БД как ключи uploads/...; файлы должны читаться публично.
# После смены адреса: docker compose up -d --force-recreate app (без пересборки образа).
# В новом хранилище сохраните те же ключи; старые внешние URL и static-пути не изменяются.
S3_PUBLIC_URL=http://localhost:9000/proletarka

# Yandex ID
NEXT_PUBLIC_METRIKA_ID=12345678
